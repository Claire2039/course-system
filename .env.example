# 复制为 .env 后按需修改。生产环境务必改所有密码与密钥。

# ===== 通用 =====
ENVIRONMENT=development
# 本地用 :80（HTTP）；生产改成真实域名如 course.example.com 以启用 Caddy 自动 HTTPS
SITE_ADDRESS=:80

# ===== PostgreSQL =====
POSTGRES_USER=course
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=coursedb

# ===== MinIO 对象存储（作业附件）=====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_prod
MINIO_BUCKET=courses
MINIO_CONSOLE_PORT=9001   # 宿主机映射的 MinIO 控制台端口

# ===== 会话密钥（生产请生成长随机串）=====
SESSION_SECRET=please_generate_a_long_random_string
SESSION_COOKIE_DOMAIN=     # 生产填你的域名；本地留空
